#!/bin/sh
# Open the optional project directory and enable the editor IDE layout.
set -eu
if [ "$#" -gt 0 ] && [ -d "$1" ]; then
    cd -- "$1"
    shift
fi
export NVIM_IDE=1
# Use the target machine's executable; allow an explicit executable-path override.
export NVIM_IDE_FETCH="${NVIM_IDE_FETCH:-neofetch}"
exec nvim "$@"
