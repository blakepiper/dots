{
  "layer": "top",
  "position": "top",
  "height": 24,
  "modules-left": [
    "custom/workspace-1",
    "custom/workspace-2",
    "custom/workspace-3",
    "custom/workspace-4",
    "custom/workspace-5",
    "custom/workspace-6",
    "custom/workspace-7",
    "custom/workspace-8",
    "custom/workspace-9"
  ],
  "modules-right": [
    "battery",
    "memory",
    "cpu",
    "clock"
  ],
  "battery": {
    "interval": 30,
    "format": "Bat: {capacity}% {time}",
    "format-charging": "Bat: {capacity}% +"
  },
  "memory": {
    "interval": 5,
    "format": "Ram: {used:0.1f}/{total:0.1f} GB"
  },
  "cpu": {
    "interval": 5,
    "format": "CPU: {usage}%"
  },
  "clock": {
    "interval": 60,
    "format": "{:%a, %b %d - %H:%M}"
  },
  "custom/workspace-1": {
    "exec": "workstation-hyprland-workspace 1",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=1})'"
  },
  "custom/workspace-2": {
    "exec": "workstation-hyprland-workspace 2",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=2})'"
  },
  "custom/workspace-3": {
    "exec": "workstation-hyprland-workspace 3",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=3})'"
  },
  "custom/workspace-4": {
    "exec": "workstation-hyprland-workspace 4",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=4})'"
  },
  "custom/workspace-5": {
    "exec": "workstation-hyprland-workspace 5",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=5})'"
  },
  "custom/workspace-6": {
    "exec": "workstation-hyprland-workspace 6",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=6})'"
  },
  "custom/workspace-7": {
    "exec": "workstation-hyprland-workspace 7",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=7})'"
  },
  "custom/workspace-8": {
    "exec": "workstation-hyprland-workspace 8",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=8})'"
  },
  "custom/workspace-9": {
    "exec": "workstation-hyprland-workspace 9",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl dispatch 'hl.dsp.focus({workspace=9})'"
  }
}
