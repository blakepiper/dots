[Unit]
Description=Restore and watch Hyprland desktop settings
PartOf=workstation-hyprland-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionEnvironment=HYPRLAND_INSTANCE_SIGNATURE

[Service]
Type=exec
ExecCondition=/usr/bin/env sh -c 'command -v desktop-settings-apply >/dev/null'
ExecStart=/usr/bin/env desktop-settings-apply watch-session
Restart=on-failure
RestartSec=2
