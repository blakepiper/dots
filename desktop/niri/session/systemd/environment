#!/usr/bin/env bash
set -euo pipefail
case ${1:-start} in
    start)
        dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY \
            XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE PATH MOZ_ENABLE_WAYLAND
        ;;
    stop)
        dbus-update-activation-environment DISPLAY= WAYLAND_DISPLAY= XDG_CURRENT_DESKTOP= XDG_SESSION_DESKTOP= XDG_SESSION_TYPE= MOZ_ENABLE_WAYLAND=
        systemctl --user unset-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE MOZ_ENABLE_WAYLAND
        ;;
    *) exit 2 ;;
esac
