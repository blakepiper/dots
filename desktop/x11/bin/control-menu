#!/bin/sh
set -eu
choice=$(printf '%s\n' Lock Suspend Reboot 'Log Out' 'Monitors Off' 'Power Off' | dmenu -i -p System) || exit 0
case "$choice" in
    Lock) exec workstation-lock ;;
    Suspend) exec desktop-power suspend ;;
    'Monitors Off') exec xset dpms force off ;;
    Reboot|'Log Out'|'Power Off')
        answer=$(printf '%s\n' No Yes | dmenu -i -p "$choice?") || exit 0
        [ "$answer" = Yes ] || exit 0
        case "$choice" in
            Reboot) exec desktop-power reboot ;;
            'Power Off') exec desktop-power poweroff ;;
            'Log Out') exec xdotool key --clearmodifiers super+shift+q ;;
        esac ;;
esac
